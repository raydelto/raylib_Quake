# CMake build trees
/build*/
CMakeCache.txt
CMakeFiles/
cmake-build-*/
compile_commands.json

# Local logs from builds and test runs
*.log

# Quake game data is never committed (shareware pak0.pak is fetched for testing)
/data/
*.pak
*.PAK

# Verification harness output (tools/verify.sh)
/verification-results/
__pycache__/

# Files the game writes at runtime
*.pcx
*.sav
*.wav
config.cfg

# Browser touch test output (scripts/web_touch.mjs)
/web-touch/

# Renderer comparison output (scripts/web_renderers.mjs)
/web-renderers/
